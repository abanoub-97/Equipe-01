# Copier en .env (non versionné) et remplir. Les variables d'environnement déjà
# définies gardent la priorité.

# --- Rédaction des fiches ---
# llm (défaut) ou regles
PROSPECT_WRITER=llm

# Option 1 : Ollama en local (défaut)
PROSPECT_LLM_PROVIDER=ollama
PROSPECT_LLM_MODEL=qwen2.5:3b

# Option 2 : une API compatible OpenAI (offre gratuite possible, vérifier les quotas)
# Groq :
# PROSPECT_LLM_PROVIDER=openai
# PROSPECT_LLM_BASE_URL=https://api.groq.com/openai/v1
# PROSPECT_LLM_MODEL=llama-3.3-70b-versatile
# PROSPECT_LLM_API_KEY=
# Mistral :
# PROSPECT_LLM_BASE_URL=https://api.mistral.ai/v1
# PROSPECT_LLM_MODEL=mistral-small-latest
# Gemini :
# PROSPECT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# PROSPECT_LLM_MODEL=gemini-2.0-flash

# Fiches rédigées en arrière-plan au chargement d'un jeu de données
PROSPECT_PREGENERATE=10
